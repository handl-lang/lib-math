--- math tests — smoke coverage for the `math` facade (`src/index.hnl`),
--- which re-exports the pure-handl (`math-handl`) total arrows and the
--- native-backed (`math-c`) arrows. These asserts exercise the
--- handl-backed half, which is deterministic without host natives.

from "./index" import * as m

test_min := assert m.min(3, 7) == 3
test_max := assert m.max(3, 7) == 7
test_abs := assert m.abs(-4) == 4
test_add := assert m.add(2, 3) == 5
test_sub := assert m.sub(5, 3) == 2
test_mul := assert m.mul(4, 3) == 12
test_div := assert m.div(7.0, 2) == 3.5
test_mod := assert m.mod(7, 3) == 1
test_clamp := assert m.clamp(11, 0, 10) == 10
test_lerp := assert m.lerp(0, 10, 0.5) == 5
test_map_range := assert m.map_range(5, 0, 10, 0, 100) == 50
test_sign := assert m.sign(-2) == -1.0
test_is_positive := assert m.is_positive(1) == true
test_is_negative := assert m.is_negative(-1) == true
test_is_integer := assert m.is_integer(3) == true
